# Deny by default: a developer's working directory can contain approved private feeds/credentials.
**
!Dockerfile
!.dockerignore
!backend/
backend/*
!backend/pyproject.toml
!backend/uv.lock
!backend/alembic.ini
!backend/config/
backend/config/*
!backend/config/application.toml
!backend/src/
backend/src/*
!backend/src/otm/
!backend/src/otm/**
!backend/migrations/
!backend/migrations/**
!backend/contracts/
!backend/contracts/**
!frontend/
frontend/*
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/generate-contracts.mjs
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
**/__pycache__/**
**/*.pyc
**/.local-dev/**
**/.venv/**
**/node_modules/**
**/.git/**
**/.aws/**
**/.env*
**/*.pem
**/*.key
