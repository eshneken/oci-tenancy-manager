# Synthetic shape only; actual inputs belong in a private ignored operator file.
target = {
  # Fixed production label; this is not an IAM authorization check.
  environment = "production"
  # Intended tenancy OCID; syntax checks do not replace verifying the live principal's scope.
  tenancy_ocid = "ocid1.tenancy.oc1..syntheticproduction"
  # Exact expected namespace, compared with the selected tenancy's namespace read.
  object_storage_namespace = "syntheticproduction"
  # Explicit deployment region; the initial approved regional target is Ashburn.
  region = "us-ashburn-1"
}
# SecurityToken, ResourcePrincipal or InstancePrincipal only; no API-key fallback.
oci_auth = "SecurityToken"
# Private authenticated profile name, nonempty and <=128 characters; SecurityToken only.
# Authenticate it separately; never paste key/token material into variables.
oci_profile = "DEFAULT"

# Set hosting_compartment_ocid privately only when adopting an existing compartment.
# The resulting bootstrap output becomes the infrastructure workflow's hosting compartment input.
#
# Set github_delivery privately with the exact verified identifiers before provisioning federation.
# github_delivery = {
#   identity_domain_ocid = "ocid1.domain.oc1..syntheticproduction"
#   repository          = "example/tenancy-manager"
#   repository_id       = "1001"
#   repository_owner_id = "1002"
#   trust_active        = false
# }

# GitHub reviewer IDs and settings filename are synthetic. Fresh deployments start held.
github_environment = {
  reviewer_user_ids = [1003]
  settings_file     = "production-workflow.json"
  kubernetes_version = "v1.34.1"
  postgresql_version = "16"
}

# Enable only after approval of the reviewed hosted runtime IAM statements.
# allow_runtime_policy_writes = true
# Set github_delivery.exchange_write_response_qualified only after isolated provider response qualification.

# Set only with separate approval for domain-wide application management.
# identity_app_management_environments = ["production"]
