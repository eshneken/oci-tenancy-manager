{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:otm:design:c5:1-draft",
  "title": "C5 collection and delivery design-contract examples",
  "$comment": "Design review only. Context references the existing local C2 schema. Not production DTOs, an API, source qualification or authority to send. Currency/period evidence and minor units are resolved source-profile projections, not invented Budget response fields.",
  "oneOf": [
    {
      "$ref": "#/$defs/BudgetReadRequest"
    },
    {
      "$ref": "#/$defs/BudgetReadResult"
    },
    {
      "$ref": "#/$defs/FinancialSnapshot"
    },
    {
      "$ref": "#/$defs/FinancialCase"
    },
    {
      "$ref": "#/$defs/PublicationCase"
    },
    {
      "$ref": "#/$defs/EmailIntent"
    },
    {
      "$ref": "#/$defs/EmailOutcome"
    },
    {
      "$ref": "#/$defs/DeliveryCase"
    },
    {
      "$ref": "#/$defs/RoutingCase"
    }
  ],
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenancy_id": {
          "type": "string",
          "format": "uuid"
        },
        "collection_id": {
          "type": "string",
          "format": "uuid"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "intent_revision": {
          "type": "integer",
          "minimum": 1
        },
        "execution_generation": {
          "type": "integer",
          "minimum": 1
        },
        "source_access_context_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_context_generation": {
          "type": "integer",
          "minimum": 1
        },
        "budget_binding_id": {
          "type": "string",
          "format": "uuid"
        },
        "budget_binding_generation": {
          "type": "integer",
          "minimum": 1
        },
        "configuration_id": {
          "type": "string",
          "format": "uuid"
        },
        "configuration_generation": {
          "type": "integer",
          "minimum": 1
        },
        "source_policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_tenancy_ocid": {
          "type": "string",
          "pattern": "^ocid1\\.tenancy\\.[A-Za-z0-9._-]+$"
        },
        "budget_ocid": {
          "type": "string",
          "pattern": "^ocid1\\.budget\\.[A-Za-z0-9._-]+$"
        },
        "expected_period_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expected_period_end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "billing_timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "workspace_id",
        "tenancy_id",
        "collection_id",
        "operation_id",
        "attempt_id",
        "intent_revision",
        "execution_generation",
        "source_access_context_id",
        "source_context_generation",
        "budget_binding_id",
        "budget_binding_generation",
        "configuration_id",
        "configuration_generation",
        "source_policy_revision",
        "scope_hash",
        "source_tenancy_ocid",
        "budget_ocid",
        "expected_period_start",
        "expected_period_end",
        "billing_timezone"
      ],
      "additionalProperties": false
    },
    "ProviderBudget": {
      "type": "object",
      "properties": {
        "budget_ocid": {
          "type": "string",
          "pattern": "^ocid1\\.budget\\.[A-Za-z0-9._-]+$"
        },
        "owning_compartment_ocid": {
          "type": "string",
          "pattern": "^ocid1\\.tenancy\\.[A-Za-z0-9._-]+$"
        },
        "target_type": {
          "const": "COMPARTMENT"
        },
        "target_ocids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ocid1\\.tenancy\\.[A-Za-z0-9._-]+$"
          },
          "minItems": 1,
          "maxItems": 300,
          "uniqueItems": true
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,15})\\.[0-9]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual_spend": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "forecasted_spend": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_spend_computed": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle_facts": {
          "$ref": "#/$defs/BudgetCycleFacts"
        }
      },
      "required": [
        "budget_ocid",
        "owning_compartment_ocid",
        "target_type",
        "target_ocids",
        "amount",
        "actual_spend",
        "forecasted_spend",
        "time_spend_computed",
        "cycle_facts"
      ],
      "additionalProperties": false
    },
    "BudgetReadRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "read_managed_budget"
        },
        "contract_version": {
          "const": "c5-design/v1"
        },
        "context": {
          "$ref": "urn:otm:design:execution:1-draft#/$defs/Context"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "payload": {
          "type": "object",
          "properties": {
            "budget_id": {
              "type": "string",
              "pattern": "^ocid1\\.budget\\.[A-Za-z0-9._-]+$"
            }
          },
          "required": [
            "budget_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "contract_version",
        "context",
        "source",
        "payload"
      ],
      "additionalProperties": false
    },
    "BudgetReadResult": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "budget_read_observed",
            "budget_read_unobservable"
          ]
        },
        "contract_version": {
          "const": "c5-design/v1"
        },
        "context": {
          "$ref": "urn:otm:design:execution:1-draft#/$defs/Context"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "provider_request_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic_code": {
          "enum": [
            "ok",
            "read_timeout",
            "read_denied_or_not_found",
            "normalization_unsupported"
          ]
        },
        "failure_category": {
          "enum": [
            "none",
            "read_failure",
            "data_unqualified"
          ]
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderBudget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "contract_version",
        "context",
        "source",
        "captured_at",
        "provider_request_reference",
        "diagnostic_code",
        "failure_category",
        "response"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "budget_read_observed"
              }
            }
          },
          "then": {
            "properties": {
              "response": {
                "$ref": "#/$defs/ProviderBudget"
              },
              "diagnostic_code": {
                "const": "ok"
              },
              "failure_category": {
                "const": "none"
              }
            }
          },
          "else": {
            "properties": {
              "response": {
                "type": "null"
              },
              "diagnostic_code": {
                "enum": [
                  "read_timeout",
                  "read_denied_or_not_found",
                  "normalization_unsupported"
                ]
              },
              "failure_category": {
                "enum": [
                  "read_failure",
                  "data_unqualified"
                ]
              }
            }
          }
        }
      ]
    },
    "FinancialSnapshot": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "financial_snapshot"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "observed_budget_amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,15})\\.[0-9]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual_spend": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "forecasted_spend": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "forecast_semantics": {
          "const": "complete_cycle_end"
        },
        "time_spend_computed": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency_minor_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "currency_policy_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "currency_evidence_event_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "spend_period_start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "spend_period_end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "period_state": {
          "enum": [
            "current",
            "prior",
            "unknown"
          ]
        },
        "period_evidence_event_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "fresh_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_availability": {
          "enum": [
            "available",
            "unavailable",
            "stale",
            "unverified"
          ]
        },
        "actual_availability": {
          "enum": [
            "available",
            "unavailable",
            "stale",
            "unverified"
          ]
        },
        "forecast_availability": {
          "enum": [
            "available",
            "unavailable",
            "stale",
            "unverified"
          ]
        },
        "observed_cycle_facts": {
          "$ref": "#/$defs/BudgetCycleFacts"
        }
      },
      "required": [
        "kind",
        "source",
        "captured_at",
        "observed_budget_amount",
        "actual_spend",
        "forecasted_spend",
        "forecast_semantics",
        "time_spend_computed",
        "currency",
        "currency_minor_units",
        "currency_policy_revision",
        "currency_evidence_event_id",
        "spend_period_start",
        "spend_period_end",
        "period_state",
        "period_evidence_event_id",
        "fresh_until",
        "budget_availability",
        "actual_availability",
        "forecast_availability",
        "observed_cycle_facts"
      ],
      "additionalProperties": false
    },
    "FinancialCase": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "financial_case"
        },
        "request": {
          "$ref": "#/$defs/BudgetReadRequest"
        },
        "result": {
          "$ref": "#/$defs/BudgetReadResult"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinancialSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "profile": {
          "$ref": "#/$defs/QualifiedProfile"
        }
      },
      "required": [
        "kind",
        "request",
        "result",
        "snapshot",
        "as_of",
        "profile"
      ],
      "additionalProperties": false
    },
    "PublicationCase": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "publication_case"
        },
        "financial": {
          "$ref": "#/$defs/FinancialCase"
        },
        "live_source": {
          "$ref": "#/$defs/Source"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinancialSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "financial",
        "live_source",
        "previous"
      ],
      "additionalProperties": false
    },
    "DeliveryContext": {
      "type": "object",
      "properties": {
        "runtime_policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "service_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sender_identity_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "adapter_contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "credential_version_id": {
          "type": "string",
          "format": "uuid"
        },
        "submission_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "credential_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "runtime_policy_revision",
        "service_reference",
        "sender_identity_reference",
        "adapter_contract_version",
        "credential_version_id",
        "submission_key",
        "credential_reference"
      ],
      "additionalProperties": false
    },
    "Recipient": {
      "type": "object",
      "properties": {
        "actor_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "responsible_admin",
              "admin",
              "owner",
              "manager",
              "designee"
            ]
          },
          "minItems": 1,
          "maxItems": 300,
          "uniqueItems": true
        }
      },
      "required": [
        "actor_subject",
        "email",
        "roles"
      ],
      "additionalProperties": false
    },
    "Responsibility": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "responsible_actor_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_revision": {
          "type": "integer",
          "minimum": 1
        },
        "responsibility_event_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation_id",
        "responsible_actor_subject",
        "operation_revision",
        "responsibility_event_id"
      ],
      "additionalProperties": false
    },
    "EmailIntent": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "email_intent"
        },
        "notification_id": {
          "type": "string",
          "format": "uuid"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "notice_family": {
          "enum": [
            "lifecycle",
            "cost_read_failure",
            "access_loss",
            "recovery_disclosure",
            "rotation_failure",
            "organization"
          ]
        },
        "notice_kind": {
          "enum": [
            "action_required",
            "terminal_failure",
            "cost_read_exhausted",
            "required_operational"
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "attention_episode_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "responsibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Responsibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "routing_policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recipients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Recipient"
          },
          "minItems": 1,
          "maxItems": 300,
          "uniqueItems": true
        },
        "template_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "safe_payload": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "operation_detail_path": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^/operations/[0-9a-f-]{36}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "summary",
            "operation_detail_path"
          ],
          "additionalProperties": false
        },
        "delivery_context": {
          "$ref": "#/$defs/DeliveryContext"
        },
        "channel": {
          "const": "email"
        },
        "supersedes_notification_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "notification_id",
        "workspace_id",
        "source_event_id",
        "notice_family",
        "notice_kind",
        "operation_id",
        "attention_episode_key",
        "responsibility",
        "routing_policy_revision",
        "recipients",
        "template_version",
        "safe_payload",
        "delivery_context",
        "channel",
        "supersedes_notification_id"
      ],
      "additionalProperties": false
    },
    "EmailOutcome": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "email_outcome"
        },
        "notification_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "delivery_context": {
          "$ref": "#/$defs/DeliveryContext"
        },
        "outcome": {
          "enum": [
            "accepted",
            "delivered",
            "rejected",
            "partial",
            "uncertain"
          ]
        },
        "recipient_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 320
              },
              "status": {
                "enum": [
                  "accepted",
                  "delivered",
                  "rejected",
                  "unknown"
                ]
              },
              "provider_reference": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "email",
              "status",
              "provider_reference"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 300,
          "uniqueItems": true
        },
        "delivered_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "notification_id",
        "attempt_id",
        "delivery_context",
        "outcome",
        "recipient_outcomes",
        "delivered_at"
      ],
      "additionalProperties": false
    },
    "DeliveryCase": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "delivery_case"
        },
        "intent": {
          "$ref": "#/$defs/EmailIntent"
        },
        "result": {
          "$ref": "#/$defs/EmailOutcome"
        },
        "authorized_attempt_context": {
          "$ref": "#/$defs/DeliveryContext"
        }
      },
      "required": [
        "kind",
        "intent",
        "result",
        "authorized_attempt_context"
      ],
      "additionalProperties": false
    },
    "RoutingCase": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "routing_case"
        },
        "intent": {
          "$ref": "#/$defs/EmailIntent"
        },
        "live_responsibility": {
          "$ref": "#/$defs/Responsibility"
        },
        "authorized_subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 300,
          "uniqueItems": true
        },
        "submission_state": {
          "enum": [
            "known_unsent",
            "accepted",
            "uncertain"
          ]
        },
        "corrected_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailIntent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "intent",
        "live_responsibility",
        "authorized_subjects",
        "submission_state",
        "corrected_intent"
      ],
      "additionalProperties": false
    },
    "QualifiedProfile": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency_minor_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "currency_evidence_event_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_max_age_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieval_max_age_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "qualified_cycle_facts": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetCycleFacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle_qualification_event_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "currency",
        "currency_minor_units",
        "currency_evidence_event_id",
        "source_max_age_seconds",
        "retrieval_max_age_seconds",
        "qualified_cycle_facts",
        "cycle_qualification_event_id"
      ]
    },
    "BudgetCycleFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reset_period": {
          "enum": [
            "MONTHLY",
            "UNKNOWN_ENUM_VALUE",
            null
          ]
        },
        "processing_period_type": {
          "enum": [
            "MONTH",
            "INVOICE",
            "SINGLE_USE",
            "UNKNOWN_ENUM_VALUE",
            null
          ]
        },
        "budget_processing_period_start_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            {
              "type": "null"
            }
          ]
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "reset_period",
        "processing_period_type",
        "budget_processing_period_start_offset",
        "start_date",
        "end_date"
      ]
    }
  }
}
