        },
        "provider_operation_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "safe_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 96
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 32
        },
        "kind": {
          "const": "unsupported"
        },
        "continuation": {
          "enum": [
            "manual",
            "observe"
          ]
        }
      },
      "required": [
        "contract_version",
        "attempt_id",
        "observed_at",
        "provider_request_id",
        "provider_operation_id",
        "safe_code",
        "evidence",
        "kind",
        "continuation"
      ],
      "additionalProperties": false
    },
    "Result": {
      "oneOf": [
        {
          "$ref": "#/$defs/Result_confirmed"
        },
        {
          "$ref": "#/$defs/Result_accepted"
        },
        {
          "$ref": "#/$defs/Result_pending"
        },
        {
          "$ref": "#/$defs/Result_rejected"
        },
        {
          "$ref": "#/$defs/Result_unknown"
        },
        {
          "$ref": "#/$defs/Result_unobservable"
        },
        {
          "$ref": "#/$defs/Result_unsupported"
        }
      ]
    },
    "OperationSnapshot": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "execution-1-draft"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "create",
            "import",
            "inspect_import",
            "termination"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "waiting",
            "needs_attention",
            "succeeded",
            "cancelled",
            "failed"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "wait_reason": {
          "anyOf": [
            {
              "enum": [
                "provider",
                "administrator",
                "retry",
                "reconcile",
                "restore_fence"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "next_check_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unfinished_mandatory_steps": {
          "type": "integer",
          "minimum": 0
        },
        "effect_knowledge": {
          "enum": [
            "none",
            "known",
            "unknown"
          ]
        },
        "stop_requested": {
          "type": "boolean"
        },
        "cleanup_status": {
          "enum": [
            "not_needed",
            "pending",
            "verified",
            "blocked"
          ]
        },
        "owner_sign_in": {
          "enum": [
            "not_confirmed",
            "confirmed",
            "check_unavailable"
          ]
        },
        "available_actions": {
          "type": "array",
          "items": {
            "enum": [
              "view",
              "resume",
              "reconcile",
              "amend",
              "request_stop",
              "refresh_preview"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "contract_version",
        "operation_id",
        "workspace_id",
        "kind",
        "revision",
        "state",
        "stage",
        "wait_reason",
        "next_check_at",
        "unfinished_mandatory_steps",
        "effect_knowledge",
        "stop_requested",
        "cleanup_status",
        "owner_sign_in",
        "available_actions"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "waiting"
              }
            }
          },
          "then": {
            "properties": {
              "wait_reason": {
                "enum": [
                  "provider",
                  "administrator",
                  "retry",
                  "reconcile",
                  "restore_fence"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "wait_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "succeeded",
                  "cancelled",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "effect_knowledge": {
                "enum": [
                  "none",
                  "known"
                ]
              },
              "cleanup_status": {
                "enum": [
                  "not_needed",
                  "verified"
                ]
              },
              "available_actions": {
                "const": [
                  "view"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "waiting"
              },
              "wait_reason": {
                "enum": [
                  "provider",
                  "retry",
                  "reconcile"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "next_check_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "unfinished_mandatory_steps": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "effect_knowledge": {
                "const": "none"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect_knowledge": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "available_actions": {
                "type": "array",
                "items": {
                  "enum": [
                    "view",
                    "reconcile",
                    "request_stop"
                  ]
                },
                "uniqueItems": true
              }
            }
          }
        }
      ]
    }
  }
}
