        "kind": {
          "const": "accepted"
        },
        "milestone": {
          "const": "child_request_accepted"
        },
        "continuation": {
          "const": "observe"
        }
      },
      "required": [
        "contract_version",
        "attempt_id",
        "observed_at",
        "provider_request_id",
        "provider_operation_id",
        "safe_code",
        "evidence",
