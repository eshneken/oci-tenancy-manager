            },
            {
              "key": "Service",
              "value": "Engineering"
            }
          ]
        },
        "policy": {
          "statements": [
            "Allow group OTMOperators to read instance-family in tenancy"
          ]
        }
      }
    },
    {
      "id": "clear-policy-inherits-new-base",
      "baseline": "baseline-v2.json",
      "override": "grant-overlay.json",
      "update": true,
      "review": [
        "quota"
      ],
      "override_changes": [
        {
          "path": [
            "policy_statements"
          ],
          "remove": true
        },
        {
          "path": [
            "reviewed_against",
            "policy"
          ],
          "remove": true
        }
      ],
      "expected": {
        "policy": {
          "statements": [
            "Allow group OTMOperators to read all-resources in tenancy",
            "Allow group OTMOperators to read audit-events in tenancy"
          ]
        }
      }
    },
    {
      "id": "multiline-is-one-string",
      "baseline": "baseline-v1.json",
      "override": "grant-overlay.json",
      "override_changes": [
        {
          "path": [
            "policy_statements"
          ],
          "value": [
            "Allow group OTMOperators\n to read all-resources in tenancy"
