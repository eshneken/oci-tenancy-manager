{
  "positive": [
    {
      "id": "inherit-baseline",
      "baseline": "baseline-v1.json",
      "override": null,
      "expected": {
        "policy": {
          "statements": [
            "Allow group OTMOperators to read all-resources in tenancy"
          ]
        },
        "quota": {
          "statements": [
            "set compute-core quota standard2-core-count to 8 in tenancy",
            "set compute-core quota standard-e4-core-count to 4 in tenancy"
          ]
        }
      }
    },
    {
      "id": "full-block-replacement",
      "baseline": "baseline-v1.json",
      "override": "grant-overlay.json",
      "expected": {
        "policy": {
          "statements": [
            "Allow group OTMOperators to read instance-family in tenancy"
          ]
        },
        "quota": {
          "statements": [
            "set compute-core quota standard2-core-count to 16 in tenancy"
          ]
        }
      }
    },
    {
