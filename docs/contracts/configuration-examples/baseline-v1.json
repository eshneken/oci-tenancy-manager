{
  "baseline_id": "organization-baseline",
  "version": 1,
  "policy": {
    "statements": [
      "Allow group OTMOperators to read all-resources in tenancy"
    ]
  },
  "quota": {
    "statements": [
      "set compute-core quota standard2-core-count to 8 in tenancy",
      "set compute-core quota standard-e4-core-count to 4 in tenancy"
    ]
  },
  "budget": {
    "monthly_amount": 200,
    "currency": "USD",
    "period": "MONTHLY",
    "alerts": []
  },
  "tags": {
    "namespace": "OTM",
    "defaults": [
      {
        "key": "ManagedBy",
        "value": "OTM"
      },
      {
        "key": "Environment",
        "value": "Engineering"
      }
    ]
  }
}
