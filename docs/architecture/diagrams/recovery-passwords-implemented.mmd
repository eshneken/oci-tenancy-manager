%% Implemented source subset through0027; qualification/install status is recorded in the password checkpoint receipt. Frozen migrations are authoritative.
erDiagram
  otm_tenancy ||--o{ otm_credential : scoped_child
  otm_managed_object_binding ||--o| otm_credential : exact_recovery_subject
  otm_operation ||--o{ otm_credential : setup_origin
  otm_operation ||--o{ otm_credential : current_system_work
  otm_credential ||--o{ otm_credential_version : immutable_versions
  otm_credential_version |o--o| otm_credential : current_pointer
  otm_credential_version |o--o| otm_credential : staged_pointer
  otm_credential ||--o{ otm_human_access_grant : disclosure_attempts
  otm_credential_version ||--o{ otm_human_access_grant : exact_version
  otm_human_access_grant |o--o| otm_credential : active_window_root
  otm_human_access_grant ||--o{ otm_human_access_grant : shared_root
  otm_operation ||--o{ otm_human_access_grant : accepted_rotation
  otm_operation ||--o{ otm_credential_version : created_by
  otm_tenancy { uuid id PK }
  otm_managed_object_binding { uuid id PK }
  otm_operation { uuid id PK }
  otm_credential {
    uuid id PK
    string workspace_id FK
    uuid tenancy_id FK
    uuid principal_binding_id FK
    uuid source_operation_id FK
    jsonb location
    string location_hash
    string state
    int generation
    uuid current_version_id FK
    uuid staged_version_id FK
    int exposure_generation
    datetime first_disclosure_at
    datetime rotation_due_at
    uuid active_window_grant_id FK
    uuid rotation_operation_id FK
    datetime created_at
    datetime updated_at
  }
  otm_credential_version {
    uuid id PK
    string workspace_id FK
    uuid credential_id FK
    int version_number
    jsonb reference
    string reference_hash
    uuid created_operation_id FK
    datetime created_at
  }
  otm_human_access_grant {
    uuid id PK
    string workspace_id FK
    uuid tenancy_id FK
    uuid credential_id FK
    uuid disclosed_version_id FK
    string requesting_subject
    jsonb requester_snapshot
    uuid request_key
    string payload_digest
    uuid accepted_operation_id FK
    uuid window_root_grant_id FK
    int exposure_generation
    datetime accepted_at
    datetime first_disclosure_attempt_at
    datetime due_at
  }
