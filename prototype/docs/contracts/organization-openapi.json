        "additionalProperties": false,
        "type": "object",
        "required": [
          "organization_revision_id",
          "configuration_revision_id",
          "source_snapshot_id",
          "published_at",
          "source_captured_at",
          "declared_completeness",
          "assessed_coverage",
          "absence_eligible"
