    "/api/local/summary": {
      "get": {
        "summary": "Summary",
        "description": "Return counts and the current applied snapshot without exposing credentials.",
        "operationId": "summary_api_local_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
