        "operationId": "tenancy_registry_api_local_tenancy_registry_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/local/tenancy-registry/operate": {
      "post": {
        "summary": "Registry Operation",
        "description": "Atomically simulate an association operation with directory and review consequences.",
        "operationId": "registry_operation_api_local_tenancy_registry_operate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistryCommand"
