            "configuration_review_staged",
            "baseline_draft_saved",
            "baseline_published",
            "baseline_default_changed",
            "operation_intent",
            "inspection_dispatch",
            "inspection_outcome",
            "organization_action_outcome",
            "onboarding_action",
            "onboarding_outcome",
            "configuration_outcome",
            "configuration_retry",
