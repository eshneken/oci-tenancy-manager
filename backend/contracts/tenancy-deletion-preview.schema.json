    "DeletionPerson": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "title": "Email",
          "type": "string"
        },
        "is_manager": {
          "title": "Is Manager",
          "type": "boolean"
        },
        "leaves_directory": {
          "title": "Leaves Directory",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "other_tenancy_count": {
          "title": "Other Tenancy Count",
          "type": "integer"
        },
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "owner",
            "member"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "person_id",
        "name",
        "email",
        "role",
        "is_manager",
        "other_tenancy_count",
        "leaves_directory"
      ],
      "title": "DeletionPerson",
      "type": "object"
    },
    "OrganizationContext": {
      "additionalProperties": false,
      "properties": {
        "applied_version_id": {
          "format": "uuid",
          "title": "Applied Version Id",
          "type": "string"
        },
        "configuration_id": {
          "format": "uuid",
          "title": "Configuration Id",
          "type": "string"
        },
        "proposed_version_id": {
          "format": "uuid",
          "title": "Proposed Version Id",
          "type": "string"
        },
        "registry_revision": {
          "minimum": 1,
          "title": "Registry Revision",
          "type": "integer"
        }
      },
      "required": [
        "applied_version_id",
        "proposed_version_id",
        "configuration_id",
        "registry_revision"
      ],
      "title": "OrganizationContext",
      "type": "object"
    },
    "TenancyView": {
      "additionalProperties": false,
      "properties": {
        "baseline_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Version Id"
        },
        "baseline_version_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
