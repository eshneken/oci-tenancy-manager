          "default": false,
          "title": "Configuration Check Stale",
          "type": "boolean"
        },
        "configuration_check_state": {
          "default": "not_checked",
          "enum": [
            "matching",
            "drifted",
            "unavailable",
            "superseded",
            "not_checked",
            "checking"
