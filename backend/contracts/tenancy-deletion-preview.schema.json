        "member_count": {
          "title": "Member Count",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "operation_completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
