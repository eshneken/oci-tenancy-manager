{
  "$defs": {
    "AdministratorAccessView": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "domain_role": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "verified",
            "missing",
            "unknown"
          ],
          "title": "Domain Role",
          "type": "string"
        },
        "group": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "verified",
            "missing",
            "unknown"
          ],
          "title": "Group",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        }
      },
      "title": "AdministratorAccessView",
      "type": "object"
    },
    "AutomationKeyView": {
      "additionalProperties": false,
      "properties": {
        "age_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Days"
        },
        "age_state": {
          "enum": [
            "within_limit",
            "due_soon",
            "overdue",
            "unknown",
            "inactive"
          ],
          "title": "Age State",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Created At"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{2}(?::[0-9a-f]{2}){15}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "key_state": {
          "enum": [
            "active",
            "inactive",
            "unknown"
          ],
          "title": "Key State",
          "type": "string"
        },
        "provider_key_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider Key Id",
          "type": "string"
        },
        "retirement_due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retirement Due At"
        }
      },
      "required": [
        "provider_key_id",
        "fingerprint",
        "created_at",
        "key_state",
        "age_state"
      ],
      "title": "AutomationKeyView",
      "type": "object"
    },
    "AutomationKeysView": {
      "additionalProperties": false,
      "properties": {
        "age_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age As Of"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "keys": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AutomationKeyView"
          },
          "maxItems": 16,
          "title": "Keys",
          "type": "array"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "state": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "known",
            "unavailable",
            "stale"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "title": "AutomationKeysView",
      "type": "object"
    },
    "RecoveryConsoleView": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "desired_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desired Fingerprint"
        },
        "mfa_exemption": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "verified",
            "drift",
            "unknown"
          ],
          "title": "Mfa Exemption",
          "type": "string"
        },
        "network_boundary": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "verified",
            "drift",
            "unknown"
          ],
          "title": "Network Boundary",
          "type": "string"
        },
        "observed_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Fingerprint"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "state": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "verified",
            "drift",
            "unknown",
            "stale"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "title": "RecoveryConsoleView",
      "type": "object"
    },
    "RequiredUserIdentity": {
      "additionalProperties": false,
      "properties": {
        "domain_ocid": {
          "maxLength": 256,
          "minLength": 15,
          "pattern": "^ocid1\\.domain\\.[A-Za-z0-9.]+$",
          "title": "Domain Ocid",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "retired_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retired At"
        },
        "scim_resource_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scim Resource Id",
          "type": "string"
        },
        "source_operation_id": {
          "format": "uuid",
          "title": "Source Operation Id",
          "type": "string"
        },
        "user_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "User Name",
          "type": "string"
        },
        "user_ocid": {
          "maxLength": 256,
          "minLength": 15,
          "pattern": "^ocid1\\.user\\.[A-Za-z0-9.]+$",
          "title": "User Ocid",
          "type": "string"
        }
      },
      "required": [
        "user_name",
        "user_ocid",
        "scim_resource_id",
        "domain_ocid",
        "recorded_at",
        "retired_at",
        "source_operation_id"
      ],
      "title": "RequiredUserIdentity",
      "type": "object"
    },
    "RequiredUserRecord": {
      "additionalProperties": false,
      "properties": {
        "administrator_access": {
          "$ref": "#/$defs/AdministratorAccessView"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequiredUserIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_state": {
          "enum": [
            "recorded",
            "not_recorded",
            "retired"
          ],
          "title": "Identity State",
          "type": "string"
        },
        "presence": {
          "$ref": "#/$defs/UserPresenceView"
        },
        "purpose": {
          "enum": [
            "automation",
            "recovery"
          ],
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "identity_state",
        "identity"
      ],
      "title": "RequiredUserRecord",
      "type": "object"
    },
    "UserPresenceView": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "state": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "present",
            "missing",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "title": "UserPresenceView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automation_keys": {
      "$ref": "#/$defs/AutomationKeysView"
    },
    "check_available": {
      "default": false,
      "title": "Check Available",
      "type": "boolean"
    },
    "check_unavailable_reason": {
      "anyOf": [
        {
          "enum": [
            "not_configured",
            "tenancy_inactive",
            "tenancy_busy",
            "provider_unavailable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "not_configured",
      "title": "Check Unavailable Reason"
    },
    "pending_operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pending Operation Id"
    },
    "provider_mode": {
      "const": "simulated",
      "title": "Provider Mode",
      "type": "string"
    },
    "recovery_console": {
      "$ref": "#/$defs/RecoveryConsoleView"
    },
    "tenancy_id": {
      "format": "uuid",
      "title": "Tenancy Id",
      "type": "string"
    },
    "tenancy_status": {
      "enum": [
        "pending",
        "active",
        "terminating",
        "terminated",
        "failed",
        "cancelled"
      ],
      "title": "Tenancy Status",
      "type": "string"
    },
    "users": {
      "items": {
        "$ref": "#/$defs/RequiredUserRecord"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Users",
      "type": "array"
    }
  },
  "required": [
    "tenancy_id",
    "tenancy_status",
    "provider_mode",
    "users"
  ],
  "title": "RequiredUsersDirectory",
  "type": "object"
}
