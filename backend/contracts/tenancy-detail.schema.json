{
  "$defs": {
    "AssociationView": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "delete",
              "transfer",
              "remove",
              "keep"
            ],
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "cleanup_required": {
          "title": "Cleanup Required",
          "type": "boolean"
        },
        "compartment_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Compartment Name"
        },
        "compartment_ocid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Compartment Ocid"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operation Id"
        },
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "owner",
            "member"
          ],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tenancy_id": {
          "format": "uuid",
          "title": "Tenancy Id",
          "type": "string"
        },
        "tenancy_kind": {
          "enum": [
            "individual",
            "shared"
          ],
          "title": "Tenancy Kind",
          "type": "string"
        },
        "tenancy_name": {
          "title": "Tenancy Name",
          "type": "string"
        },
        "tenancy_status": {
          "title": "Tenancy Status",
          "type": "string"
        },
        "user_ocid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Ocid"
        }
      },
      "required": [
        "id",
        "person_id",
        "tenancy_id",
        "tenancy_name",
        "tenancy_kind",
        "tenancy_status",
        "role",
        "status",
        "compartment_ocid",
        "compartment_name",
        "cleanup_required",
        "operation_id",
        "actions"
      ],
      "title": "AssociationView",
      "type": "object"
    },
    "BudgetCycleFacts": {
      "additionalProperties": false,
      "properties": {
        "budget_processing_period_start_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Budget Processing Period Start Offset"
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "processing_period_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Processing Period Type",
          "type": "string"
        },
        "reset_period": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reset Period",
          "type": "string"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        }
      },
      "required": [
        "reset_period",
        "processing_period_type",
        "budget_processing_period_start_offset"
      ],
      "title": "BudgetCycleFacts",
      "type": "object"
    },
    "CompartmentOption": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ocid": {
          "title": "Ocid",
          "type": "string"
        }
      },
      "required": [
        "ocid",
        "name"
      ],
      "title": "CompartmentOption",
      "type": "object"
    },
    "CostView": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "actual_over_budget": {
          "default": false,
          "title": "Actual Over Budget",
          "type": "boolean"
        },
        "budget": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        },
        "can_refresh": {
          "default": false,
          "title": "Can Refresh",
          "type": "boolean"
        },
        "computed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Computed At"
        },
        "currency": {
          "anyOf": [
            {
              "const": "USD",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "cycle_facts": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetCycleFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "desired_budget": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desired Budget"
        },
        "forecast": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forecast"
        },
        "forecast_over_budget": {
          "default": false,
          "title": "Forecast Over Budget",
          "type": "boolean"
        },
        "latest_failure": {
          "anyOf": [
            {
              "enum": [
                "COST_READ_COMPLETE",
                "COST_READ_UNAVAILABLE",
                "COST_SOURCE_UNQUALIFIED",
                "COST_TARGET_CHANGED",
                "COST_AUTHORIZATION_CHANGED",
                "COST_CONTEXT_UNAVAILABLE",
                "COST_READ_SUPERSEDED",
                "COST_RETRIES_EXHAUSTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Failure"
        },
        "minor_units": {
          "anyOf": [
            {
              "const": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minor Units"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "pending": {
          "default": false,
          "title": "Pending",
          "type": "boolean"
        },
        "period_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period End"
        },
        "period_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Start"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "state": {
          "default": "not_collected",
          "enum": [
            "not_collected",
            "current",
            "partial",
            "stale",
            "prior_cycle",
            "unavailable",
            "unqualified"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "title": "CostView",
      "type": "object"
    },
    "PersonOption": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "title": "Email",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "email"
      ],
      "title": "PersonOption",
      "type": "object"
    },
    "RequiredUsersSummary": {
      "additionalProperties": false,
      "properties": {
        "automation": {
          "$ref": "#/$defs/UserPresenceView"
        },
        "checking": {
          "default": false,
          "title": "Checking",
          "type": "boolean"
        },
        "recovery": {
          "$ref": "#/$defs/UserPresenceView"
        },
        "state": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "present",
            "missing",
            "unavailable",
            "stale"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "title": "RequiredUsersSummary",
      "type": "object"
    },
    "TenancyView": {
      "additionalProperties": false,
      "properties": {
        "baseline_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Version Id"
        },
        "baseline_version_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Version Number"
        },
        "cleanup_count": {
          "title": "Cleanup Count",
          "type": "integer"
        },
        "configuration_check_stale": {
          "default": false,
          "title": "Configuration Check Stale",
          "type": "boolean"
        },
        "configuration_check_state": {
          "default": "not_checked",
          "enum": [
            "matching",
            "drifted",
            "unavailable",
            "superseded",
            "not_checked",
            "checking"
          ],
          "title": "Configuration Check State",
          "type": "string"
        },
        "configuration_checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Checked At"
        },
        "configuration_confirmed_issue_count": {
          "default": 0,
          "title": "Configuration Confirmed Issue Count",
          "type": "integer"
        },
        "configuration_issue_count": {
          "default": 0,
          "title": "Configuration Issue Count",
          "type": "integer"
        },
        "configuration_verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Verified At"
        },
        "costs": {
          "$ref": "#/$defs/CostView",
          "default": {
            "actual": null,
            "actual_over_budget": false,
            "budget": null,
            "can_refresh": false,
            "computed_at": null,
            "currency": null,
            "cycle_facts": null,
            "desired_budget": null,
            "forecast": null,
            "forecast_over_budget": false,
            "latest_failure": null,
            "minor_units": null,
            "operation_id": null,
            "pending": false,
            "period_end": null,
            "period_start": null,
            "retrieved_at": null,
            "state": "not_collected"
          }
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "desired_configuration_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desired Configuration Id"
        },
        "has_pending_operation": {
          "default": false,
          "title": "Has Pending Operation",
          "type": "boolean"
        },
        "home_region": {
          "title": "Home Region",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "individual",
            "shared"
          ],
          "title": "Kind",
          "type": "string"
        },
        "last_verified_configuration_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Verified Configuration Id"
        },
        "leader_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Leader Name"
        },
        "lob_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lob Name"
        },
        "manager_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manager Name"
        },
        "member_count": {
          "title": "Member Count",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "operation_completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Completed At"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operation Id"
        },
        "operation_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operation State"
        },
        "origin": {
          "enum": [
            "create",
            "import"
          ],
          "title": "Origin",
          "type": "string"
        },
        "override_categories": {
          "default": [],
          "items": {
            "enum": [
              "policy",
              "quota",
              "budget"
            ],
            "type": "string"
          },
          "title": "Override Categories",
          "type": "array"
        },
        "owner_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Email"
        },
        "owner_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Name"
        },
        "owner_person_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Person Id"
        },
        "parent_tenancy_ocid": {
          "title": "Parent Tenancy Ocid",
          "type": "string"
        },
        "provider_mode": {
          "const": "simulated",
          "title": "Provider Mode",
          "type": "string"
        },
        "required_users": {
          "$ref": "#/$defs/RequiredUsersSummary"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tenancy_ocid": {
          "title": "Tenancy Ocid",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verified At"
        },
        "verified_baseline_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Baseline Version Id"
        },
        "verified_baseline_version_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Baseline Version Number"
        }
      },
      "required": [
        "id",
        "name",
        "tenancy_ocid",
        "parent_tenancy_ocid",
        "home_region",
        "kind",
        "status",
        "origin",
        "provider_mode",
        "owner_person_id",
        "owner_name",
        "owner_email",
        "manager_name",
        "leader_name",
        "lob_name",
        "member_count",
        "operation_id",
        "operation_state",
        "verified_at",
        "created_at",
        "cleanup_count"
      ],
      "title": "TenancyView",
      "type": "object"
    },
    "UserPresenceView": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "state": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "present",
            "missing",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "title": "UserPresenceView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "compartment_parents": {
      "items": {
        "$ref": "#/$defs/CompartmentOption"
      },
      "title": "Compartment Parents",
      "type": "array"
    },
    "configuration_operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Operation Id"
    },
    "memberships": {
      "items": {
        "$ref": "#/$defs/AssociationView"
      },
      "title": "Memberships",
      "type": "array"
    },
    "onboarding_operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Onboarding Operation Id"
    },
    "people": {
      "items": {
        "$ref": "#/$defs/PersonOption"
      },
      "title": "People",
      "type": "array"
    },
    "tenancy": {
      "$ref": "#/$defs/TenancyView"
    }
  },
  "required": [
    "tenancy",
    "people",
    "memberships",
    "compartment_parents"
  ],
  "title": "TenancyDetail",
  "type": "object"
}
