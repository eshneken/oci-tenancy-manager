{
  "$defs": {
    "BaselineContent": {
      "additionalProperties": false,
      "properties": {
        "budget_currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Budget Currency",
          "type": "string"
        },
        "budget_period": {
          "const": "MONTHLY",
          "default": "MONTHLY",
          "title": "Budget Period",
          "type": "string"
        },
        "monthly_budget_amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Monthly Budget Amount"
        },
        "policy_statements": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Policy Statements",
          "type": "array"
        },
        "quota_statements": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Quota Statements",
          "type": "array"
        },
        "tag_defaults": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TagDefault"
          },
          "maxItems": 100,
          "title": "Tag Defaults",
          "type": "array"
        },
        "tag_namespace": {
          "const": "OTM",
          "default": "OTM",
          "title": "Tag Namespace",
          "type": "string"
        }
      },
      "required": [
        "policy_statements",
        "quota_statements",
        "monthly_budget_amount",
        "budget_currency"
      ],
      "title": "BaselineContent",
      "type": "object"
    },
    "BaselineVersion": {
      "additionalProperties": false,
      "properties": {
        "based_on_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Based On Id"
        },
        "content": {
          "$ref": "#/$defs/BaselineContent"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "edit_revision": {
          "minimum": 1,
          "title": "Edit Revision",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "publication_mode": {
          "anyOf": [
            {
              "const": "simulated",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Mode"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "published_by": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published By"
        },
        "published_by_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published By Name"
        },
        "version_number": {
          "minimum": 1,
          "title": "Version Number",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version_number",
        "edit_revision",
        "created_by",
        "created_at",
        "content_hash",
        "content"
      ],
      "title": "BaselineVersion",
      "type": "object"
    },
    "OverrideValues": {
      "additionalProperties": false,
      "properties": {
        "monthly_budget_override_amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthly Budget Override Amount"
        },
        "policy_override_statements": {
          "anyOf": [
            {
              "items": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Override Statements"
        },
        "quota_override_statements": {
          "anyOf": [
            {
              "items": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quota Override Statements"
        }
      },
      "title": "OverrideValues",
      "type": "object"
    },
    "TagDefault": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "TagDefault",
      "type": "object"
    },
    "TenancyConfiguration": {
      "additionalProperties": false,
      "properties": {
        "baseline_version_id": {
          "format": "uuid",
          "title": "Baseline Version Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "effective_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Effective Hash",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "monthly_budget_override_amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthly Budget Override Amount"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "policy_override_statements": {
          "anyOf": [
            {
              "items": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Override Statements"
        },
        "previous_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Id"
        },
        "quota_override_statements": {
          "anyOf": [
            {
              "items": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quota Override Statements"
        },
        "resolution_contract_version": {
          "const": "simulated-config-1",
          "default": "simulated-config-1",
          "title": "Resolution Contract Version",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "tenancy_id": {
          "format": "uuid",
          "title": "Tenancy Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenancy_id",
        "baseline_version_id",
        "revision_number",
        "previous_id",
        "operation_id",
        "created_by",
        "created_at",
        "effective_hash"
      ],
      "title": "TenancyConfiguration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "$ref": "#/$defs/BaselineVersion"
    },
    "can_edit": {
      "title": "Can Edit",
      "type": "boolean"
    },
    "configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/TenancyConfiguration"
        },
        {
          "type": "null"
        }
      ]
    },
    "tenancy_id": {
      "format": "uuid",
      "title": "Tenancy Id",
      "type": "string"
    },
    "tenancy_name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Tenancy Name",
      "type": "string"
    },
    "tenancy_revision": {
      "title": "Tenancy Revision",
      "type": "integer"
    },
    "values": {
      "$ref": "#/$defs/OverrideValues"
    }
  },
  "required": [
    "tenancy_id",
    "tenancy_name",
    "tenancy_revision",
    "baseline",
    "configuration",
    "values",
    "can_edit"
  ],
  "title": "OverrideEditor",
  "type": "object"
}
