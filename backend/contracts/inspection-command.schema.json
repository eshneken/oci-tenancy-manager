{
  "$defs": {
    "ExecutionContext": {
      "additionalProperties": false,
      "properties": {
        "access_binding_id": {
          "format": "uuid",
          "title": "Access Binding Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "credential_generation": {
          "minimum": 1,
          "title": "Credential Generation",
          "type": "integer"
        },
        "execution_generation": {
          "minimum": 1,
          "title": "Execution Generation",
          "type": "integer"
        },
        "intent_revision": {
          "minimum": 1,
          "title": "Intent Revision",
          "type": "integer"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "step_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "operation_id",
        "step_key",
        "attempt_id",
        "intent_revision",
        "execution_generation",
        "access_binding_id",
        "credential_generation"
      ],
      "title": "ExecutionContext",
      "type": "object"
    },
    "InspectionTarget": {
