          "type": "string"
        },
        "tenancy_ocid": {
          "maxLength": 256,
          "minLength": 15,
          "pattern": "^ocid1\\.tenancy\\.[A-Za-z0-9.]+$",
          "title": "Tenancy Ocid",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "parent_tenancy_ocid",
        "tenancy_ocid"
