{
  "$defs": {
    "ImportAdoption": {
      "additionalProperties": false,
      "properties": {
        "inventory_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Inventory Hash",
          "type": "string"
        },
        "lifecycle_confirmed": {
          "const": true,
          "title": "Lifecycle Confirmed",
          "type": "boolean"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/ImportMemberChoice"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        }
      },
      "required": [
        "inventory_hash",
        "members",
        "lifecycle_confirmed"
      ],
      "title": "ImportAdoption",
      "type": "object"
    },
    "ImportMemberChoice": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "user_ocid": {
          "maxLength": 256,
          "minLength": 1,
          "title": "User Ocid",
          "type": "string"
        }
      },
      "required": [
        "user_ocid",
        "person_id"
      ],
      "title": "ImportMemberChoice",
      "type": "object"
    },
    "OnboardingHandoff": {
      "additionalProperties": false,
      "properties": {
        "activation_user_ocid": {
          "anyOf": [
            {
              "pattern": "^ocid1\\.user\\.oc1\\.\\.otmsim[a-z0-9]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation User Ocid"
        },
        "bootstrap_user_ocid": {
          "pattern": "^ocid1\\.user\\.oc1\\.\\.otmsim[a-z0-9]{1,100}$",
          "title": "Bootstrap User Ocid",
          "type": "string"
        },
        "tenancy_ocid": {
          "maxLength": 256,
          "minLength": 15,
          "pattern": "^ocid1\\.tenancy\\.[A-Za-z0-9.]+$",
          "title": "Tenancy Ocid",
          "type": "string"
        }
      },
      "required": [
        "tenancy_ocid",
        "bootstrap_user_ocid"
      ],
      "title": "OnboardingHandoff",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "verify_handoff",
        "start_setup",
        "prepare_bootstrap_key",
        "refresh_import_inventory"
      ],
      "title": "Action",
      "type": "string"
    },
    "client_request_key": {
      "format": "uuid",
      "title": "Client Request Key",
      "type": "string"
    },
    "confirm_cleanup": {
      "default": false,
      "title": "Confirm Cleanup",
      "type": "boolean"
    },
    "handoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/OnboardingHandoff"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "import_adoption": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImportAdoption"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "client_request_key",
    "revision",
    "action"
  ],
  "title": "OnboardingCommand",
  "type": "object"
}
