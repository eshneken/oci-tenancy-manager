{
  "additionalProperties": false,
  "properties": {
    "available": {
      "title": "Available",
      "type": "boolean"
    },
    "first_disclosure_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Disclosure At"
    },
    "operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "preview_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Hash"
    },
    "provider_mode": {
      "const": "simulated",
      "default": "simulated",
      "title": "Provider Mode",
      "type": "string"
    },
    "rotation_due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rotation Due At"
    },
    "state": {
      "enum": [
        "not_prepared",
        "preparing",
        "ready",
        "exposed",
        "overdue",
        "rotating",
        "attention",
        "unavailable",
        "inactive"
      ],
      "title": "State",
      "type": "string"
    },
    "tenancy_id": {
      "format": "uuid",
      "title": "Tenancy Id",
      "type": "string"
    },
    "tenancy_name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Tenancy Name",
      "type": "string"
    },
    "user_name": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Name"
    }
  },
  "required": [
    "tenancy_id",
    "tenancy_name",
    "state",
    "available"
  ],
  "title": "RecoveryPasswordView",
  "type": "object"
}
