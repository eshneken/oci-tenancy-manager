          "title": "Home Region",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "individual",
            "shared"
          ],
          "title": "Kind",
          "type": "string"
        },
        "last_verified_configuration_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
