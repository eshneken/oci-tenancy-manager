{
  "$defs": {
    "TenancyView": {
      "additionalProperties": false,
      "properties": {
        "baseline_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Version Id"
        },
        "baseline_version_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Version Number"
        },
        "cleanup_count": {
          "title": "Cleanup Count",
          "type": "integer"
        },
        "configuration_check_stale": {
          "default": false,
          "title": "Configuration Check Stale",
          "type": "boolean"
        },
        "configuration_check_state": {
          "default": "not_checked",
          "enum": [
            "matching",
            "drifted",
            "unavailable",
            "superseded",
            "not_checked",
            "checking"
          ],
          "title": "Configuration Check State",
          "type": "string"
        },
        "configuration_checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Checked At"
        },
        "configuration_confirmed_issue_count": {
          "default": 0,
          "title": "Configuration Confirmed Issue Count",
          "type": "integer"
        },
        "configuration_issue_count": {
          "default": 0,
          "title": "Configuration Issue Count",
          "type": "integer"
        },
        "configuration_verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Verified At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "desired_configuration_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
