          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tenancy_ocid": {
          "title": "Tenancy Ocid",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verified At"
        },
        "verified_baseline_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Baseline Version Id"
        },
        "verified_baseline_version_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Baseline Version Number"
        }
      },
      "required": [
        "id",
        "name",
        "tenancy_ocid",
        "parent_tenancy_ocid",
        "home_region",
        "kind",
        "status",
        "origin",
        "provider_mode",
        "owner_person_id",
        "owner_name",
        "owner_email",
        "manager_name",
        "leader_name",
        "lob_name",
        "member_count",
        "operation_id",
        "operation_state",
        "verified_at",
        "created_at",
        "cleanup_count"
