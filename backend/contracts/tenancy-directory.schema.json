    "pages": {
      "title": "Pages",
      "type": "integer"
    },
    "pending_count": {
      "title": "Pending Count",
      "type": "integer"
    },
    "shared_count": {
      "title": "Shared Count",
      "type": "integer"
    },
    "total": {
