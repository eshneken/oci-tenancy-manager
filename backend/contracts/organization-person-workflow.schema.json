{
  "$defs": {
    "AssociationView": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "delete",
              "transfer",
              "remove",
              "keep"
            ],
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "cleanup_required": {
          "title": "Cleanup Required",
          "type": "boolean"
        },
        "compartment_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Compartment Name"
        },
        "compartment_ocid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Compartment Ocid"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operation Id"
        },
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "owner",
            "member"
          ],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tenancy_id": {
          "format": "uuid",
          "title": "Tenancy Id",
          "type": "string"
        },
        "tenancy_kind": {
          "enum": [
            "individual",
            "shared"
          ],
          "title": "Tenancy Kind",
          "type": "string"
        },
        "tenancy_name": {
          "title": "Tenancy Name",
          "type": "string"
        },
        "tenancy_status": {
          "title": "Tenancy Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "person_id",
        "tenancy_id",
        "tenancy_name",
        "tenancy_kind",
        "tenancy_status",
        "role",
        "status",
        "compartment_ocid",
        "compartment_name",
        "cleanup_required",
        "operation_id",
        "actions"
      ],
      "title": "AssociationView",
      "type": "object"
    },
    "BaselineContent": {
      "additionalProperties": false,
      "properties": {
        "budget_currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Budget Currency",
          "type": "string"
        },
        "budget_period": {
          "const": "MONTHLY",
          "default": "MONTHLY",
          "title": "Budget Period",
          "type": "string"
        },
        "monthly_budget_amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Monthly Budget Amount"
        },
        "policy_statements": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Policy Statements",
          "type": "array"
        },
        "quota_statements": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Quota Statements",
          "type": "array"
        },
        "tag_defaults": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TagDefault"
          },
          "maxItems": 100,
          "title": "Tag Defaults",
          "type": "array"
        },
        "tag_namespace": {
          "const": "OTM",
          "default": "OTM",
          "title": "Tag Namespace",
          "type": "string"
        }
      },
      "required": [
        "policy_statements",
        "quota_statements",
        "monthly_budget_amount",
        "budget_currency"
      ],
      "title": "BaselineContent",
      "type": "object"
    },
    "BaselineVersion": {
      "additionalProperties": false,
      "properties": {
        "based_on_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Based On Id"
        },
        "content": {
          "$ref": "#/$defs/BaselineContent"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "edit_revision": {
          "minimum": 1,
          "title": "Edit Revision",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "publication_mode": {
          "anyOf": [
            {
              "const": "simulated",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Mode"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "published_by": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published By"
        },
        "published_by_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published By Name"
        },
        "version_number": {
          "minimum": 1,
          "title": "Version Number",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version_number",
        "edit_revision",
        "created_by",
        "created_at",
        "content_hash",
        "content"
      ],
      "title": "BaselineVersion",
      "type": "object"
    },
    "CreationRegion": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "name"
      ],
      "title": "CreationRegion",
      "type": "object"
    },
    "EmailContacts": {
      "additionalProperties": false,
