{
  "$defs": {
    "MappingCandidate": {
      "additionalProperties": false,
      "properties": {
        "root_email": {
          "title": "Root Email",
          "type": "string"
        },
        "root_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Name"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/MappingSegment"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "root_email",
        "segments"
      ],
      "title": "MappingCandidate",
      "type": "object"
    },
    "MappingChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/MappingSegment"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/MappingSegment"
            },
            {
              "type": "null"
            }
          ]
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "before",
        "after"
      ],
      "title": "MappingChange",
      "type": "object"
    },
    "MappingContext": {
      "additionalProperties": false,
      "properties": {
        "applied_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applied Version Id"
        },
        "configuration_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Id"
        },
        "proposed_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Version Id"
        },
        "registry_revision": {
          "default": 0,
          "title": "Registry Revision",
          "type": "integer"
        }
      },
      "title": "MappingContext",
      "type": "object"
    },
    "MappingImpact": {
      "additionalProperties": false,
      "properties": {
        "after_ancestry": {
          "enum": [
            "root",
            "resolved",
            "incomplete"
          ],
          "title": "After Ancestry",
          "type": "string"
        },
        "after_designees": {
          "items": {
            "type": "string"
          },
          "title": "After Designees",
          "type": "array"
        },
        "after_leader": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Leader"
        },
        "after_segment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Segment"
        },
        "before_ancestry": {
          "enum": [
            "root",
            "resolved",
            "incomplete"
          ],
          "title": "Before Ancestry",
          "type": "string"
        },
        "before_designees": {
          "items": {
            "type": "string"
          },
          "title": "Before Designees",
          "type": "array"
        },
        "before_leader": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Leader"
        },
        "before_segment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Segment"
        },
        "email": {
          "title": "Email",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        }
      },
      "required": [
        "person_id",
        "name",
        "email",
        "before_ancestry",
        "after_ancestry",
        "before_segment",
        "after_segment",
        "before_leader",
        "after_leader",
        "before_designees",
        "after_designees"
      ],
      "title": "MappingImpact",
      "type": "object"
    },
    "MappingRole": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "title": "Email",
          "type": "string"
        },
        "role": {
          "enum": [
            "leader",
            "designee"
          ],
          "title": "Role",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "segment_name": {
          "title": "Segment Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "healthy",
            "departed",
            "excluded",
            "profile_missing",
            "ancestry_incomplete",
            "branch_changed",
            "not_verified"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "segment_name",
        "role",
        "email",
        "status"
      ],
      "title": "MappingRole",
      "type": "object"
    },
    "MappingSegment": {
      "additionalProperties": false,
      "properties": {
        "designee_emails": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Designee Emails",
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "leader_email": {
          "title": "Leader Email",
          "type": "string"
        }
      },
      "required": [
        "label",
        "leader_email"
      ],
      "title": "MappingSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "affected_count": {
      "title": "Affected Count",
      "type": "integer"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "candidate": {
      "$ref": "#/$defs/MappingCandidate"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/MappingChange"
      },
      "title": "Changes",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/MappingContext"
    },
    "has_feed": {
      "title": "Has Feed",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/MappingImpact"
      },
      "title": "Items",
      "type": "array"
    },
    "page": {
      "title": "Page",
      "type": "integer"
    },
    "pages": {
      "title": "Pages",
      "type": "integer"
    },
    "preview_token": {
      "title": "Preview Token",
      "type": "string"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/MappingRole"
      },
      "title": "Roles",
      "type": "array"
    },
    "root_before": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Root Before"
    },
    "root_name_before": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Root Name Before"
    },
    "root_present": {
      "title": "Root Present",
      "type": "boolean"
    },
    "unassigned_count": {
      "title": "Unassigned Count",
      "type": "integer"
    },
    "unresolved_count": {
      "title": "Unresolved Count",
      "type": "integer"
    }
  },
  "required": [
    "root_before",
    "root_present",
    "unresolved_count",
    "context",
    "candidate",
    "preview_token",
    "changes",
    "roles",
    "affected_count",
    "unassigned_count",
    "items",
    "page",
    "pages",
    "blockers",
    "has_feed"
  ],
  "title": "MappingPreview",
  "type": "object"
}
