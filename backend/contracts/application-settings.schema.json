{
  "$defs": {
    "BrandingSettings": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "default": "OCI Tenancy Manager",
          "maxLength": 80,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "icon_url": {
          "anyOf": [
            {
              "pattern": "^/branding-assets/[A-Za-z0-9][A-Za-z0-9_-]{0,79}\\.(png|webp|ico|jpg|jpeg)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon Url"
        },
        "logo_url": {
          "anyOf": [
            {
              "pattern": "^/branding-assets/[A-Za-z0-9][A-Za-z0-9_-]{0,79}\\.(png|webp|ico|jpg|jpeg)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Url"
        }
      },
      "title": "BrandingSettings",
      "type": "object"
    },
    "CaddyIngressSettings": {
      "additionalProperties": false,
      "properties": {
        "acme_email": {
          "maxLength": 254,
          "minLength": 1,
          "title": "Acme Email",
          "type": "string"
        }
      },
      "required": [
        "acme_email"
      ],
      "title": "CaddyIngressSettings",
      "type": "object"
    },
    "CostPolicy": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "simulated-usd-utc-1",
          "default": "simulated-usd-utc-1",
          "title": "Profile",
          "type": "string"
        },
        "retrieval_max_age_seconds": {
          "default": 86400,
          "maximum": 604800,
          "minimum": 1,
          "title": "Retrieval Max Age Seconds",
          "type": "integer"
        },
        "retry_delays_seconds": {
          "default": [
            30,
            120
          ],
          "items": {
            "maximum": 3600,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 0,
          "title": "Retry Delays Seconds",
          "type": "array"
        },
        "source_max_age_seconds": {
          "default": 86400,
          "maximum": 604800,
          "minimum": 1,
          "title": "Source Max Age Seconds",
          "type": "integer"
        }
      },
      "title": "CostPolicy",
      "type": "object"
    },
    "HostedOrganizationSource": {
      "additionalProperties": false,
      "properties": {
        "administrator_alert_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Administrator Alert Email"
        },
        "census_contract_confirmed": {
          "default": false,
          "title": "Census Contract Confirmed",
          "type": "boolean"
        },
        "max_age_seconds": {
          "default": 86400,
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "population_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Population Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "population_id"
      ],
      "title": "HostedOrganizationSource",
      "type": "object"
    },
    "HostedSettings": {
      "additionalProperties": false,
      "properties": {
        "database_pool_size": {
          "default": 2,
          "maximum": 16,
          "minimum": 1,
          "title": "Database Pool Size",
          "type": "integer"
        },
        "ingress": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaddyIngressSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "organization_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostedOrganizationSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "public_origin": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Public Origin",
          "type": "string"
        },
        "trusted_proxy_cidrs": {
          "items": {
            "type": "string"
          },
          "title": "Trusted Proxy Cidrs",
          "type": "array"
        },
        "worker_shutdown_seconds": {
          "default": 120,
          "maximum": 240,
          "minimum": 1,
          "title": "Worker Shutdown Seconds",
          "type": "integer"
        }
      },
      "required": [
        "public_origin",
        "trusted_proxy_cidrs"
      ],
      "title": "HostedSettings",
      "type": "object"
    },
    "LocalAuthSettings": {
      "additionalProperties": false,
      "properties": {
        "cooldown_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Cooldown Seconds",
          "type": "integer"
        },
        "failure_window_seconds": {
          "maximum": 3600,
          "minimum": 30,
          "title": "Failure Window Seconds",
          "type": "integer"
        },
        "issuer": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "max_failures": {
          "maximum": 20,
          "minimum": 1,
          "title": "Max Failures",
          "type": "integer"
        },
        "max_password_workers": {
          "maximum": 4,
          "minimum": 1,
          "title": "Max Password Workers",
          "type": "integer"
        },
        "workspace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "issuer",
        "max_failures",
        "failure_window_seconds",
        "cooldown_seconds",
        "max_password_workers"
      ],
      "title": "LocalAuthSettings",
      "type": "object"
    },
    "LocalServerSettings": {
      "additionalProperties": false,
      "properties": {
        "organization_reset_enabled": {
          "default": false,
          "title": "Organization Reset Enabled",
          "type": "boolean"
        },
        "public_origin": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Public Origin",
          "type": "string"
        }
      },
      "required": [
        "public_origin"
      ],
      "title": "LocalServerSettings",
      "type": "object"
    },
    "NotificationSettings": {
      "additionalProperties": false,
      "properties": {
        "application_origin": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application Origin"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "password_secret_reference": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password Secret Reference"
        },
        "sender_email": {
          "default": "no-reply@otm.test",
          "title": "Sender Email",
          "type": "string"
        },
        "smtp_host": {
          "default": "127.0.0.1",
          "maxLength": 256,
          "minLength": 1,
          "title": "Smtp Host",
          "type": "string"
        },
        "smtp_port": {
          "default": 1025,
          "maximum": 65535,
          "minimum": 1,
          "title": "Smtp Port",
          "type": "integer"
        },
        "tls_mode": {
          "default": "local",
          "enum": [
            "local",
            "starttls",
            "implicit"
          ],
          "title": "Tls Mode",
          "type": "string"
        },
        "username": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        }
      },
      "title": "NotificationSettings",
      "type": "object"
    },
    "OciSettings": {
      "additionalProperties": false,
      "properties": {
        "auth_method": {
          "enum": [
            "api_key_profile",
            "oke_workload_identity"
          ],
          "title": "Auth Method",
          "type": "string"
        },
        "config_file": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config File"
        },
        "profile": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "region": {
          "pattern": "^[a-z][a-z0-9-]{1,61}[0-9]$",
          "title": "Region",
          "type": "string"
        },
        "tenancy_ocid": {
          "pattern": "^ocid1\\.tenancy\\.oc[0-9]+\\.[a-z0-9.-]{1,220}$",
          "title": "Tenancy Ocid",
          "type": "string"
        }
      },
      "required": [
        "auth_method",
        "region",
        "tenancy_ocid"
      ],
      "title": "OciSettings",
      "type": "object"
    },
    "RecoveryConsoleSettings": {
      "additionalProperties": false,
      "properties": {
        "allowed_cidrs": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Allowed Cidrs",
          "type": "array"
        }
      },
      "required": [
        "allowed_cidrs"
      ],
      "title": "RecoveryConsoleSettings",
      "type": "object"
    },
    "SessionCleanupSettings": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "hour_utc": {
          "maximum": 23,
          "minimum": 0,
          "title": "Hour Utc",
          "type": "integer"
        },
        "max_batches": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Batches",
          "type": "integer"
        },
        "minute_utc": {
          "maximum": 59,
          "minimum": 0,
          "title": "Minute Utc",
          "type": "integer"
        }
      },
      "required": [
        "hour_utc",
        "minute_utc",
        "batch_size",
        "max_batches"
      ],
      "title": "SessionCleanupSettings",
      "type": "object"
    },
    "SessionSettings": {
      "additionalProperties": false,
      "properties": {
        "absolute_timeout_seconds": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Absolute Timeout Seconds",
          "type": "integer"
        },
        "cleanup": {
          "$ref": "#/$defs/SessionCleanupSettings"
        },
        "idle_timeout_seconds": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Idle Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "idle_timeout_seconds",
        "absolute_timeout_seconds",
        "cleanup"
      ],
      "title": "SessionSettings",
      "type": "object"
    },
    "TestingSettings": {
      "additionalProperties": false,
      "properties": {
        "email_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email Override"
        }
      },
      "title": "TestingSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "branding": {
      "$ref": "#/$defs/BrandingSettings",
      "default": {
        "display_name": "OCI Tenancy Manager",
        "icon_url": null,
        "logo_url": null
      }
    },
    "costs": {
      "$ref": "#/$defs/CostPolicy",
      "default": {
        "profile": "simulated-usd-utc-1",
        "retrieval_max_age_seconds": 86400,
        "retry_delays_seconds": [
          30,
          120
        ],
        "source_max_age_seconds": 86400
      }
    },
    "environment": {
      "default": "local",
      "enum": [
        "local",
        "staging",
        "production"
      ],
      "title": "Environment",
      "type": "string"
    },
    "hosted": {
      "anyOf": [
        {
          "$ref": "#/$defs/HostedSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "local_auth": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalAuthSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "local_server": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalServerSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notifications": {
      "$ref": "#/$defs/NotificationSettings",
      "default": {
        "application_origin": null,
        "enabled": false,
        "password_secret_reference": null,
        "sender_email": "no-reply@otm.test",
        "smtp_host": "127.0.0.1",
        "smtp_port": 1025,
        "tls_mode": "local",
        "username": null
      }
    },
    "oci": {
      "anyOf": [
        {
          "$ref": "#/$defs/OciSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider_mode": {
      "default": "simulated",
      "enum": [
        "simulated",
        "oci"
      ],
      "title": "Provider Mode",
      "type": "string"
    },
    "recovery_console": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecoveryConsoleSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sessions": {
      "$ref": "#/$defs/SessionSettings"
    },
    "testing": {
      "anyOf": [
        {
          "$ref": "#/$defs/TestingSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "sessions"
  ],
  "title": "ApplicationSettings",
  "type": "object"
}
